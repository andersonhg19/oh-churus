# === Build artifacts ===
**/target/
frontend/dist/
frontend/web-build/

# === Dependencies ===
frontend/node_modules/

# === Environment / Secrets ===
.env
.env.*
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# === IDE ===
.idea/
**/.idea/
*.iml
.classpath
.project
.settings/
.vscode/

# === Archives / Large files ===
*.rar
*.zip
