        "properties" : {
          "startTime" : {
            "format" : "date-time",
            "type" : "string"
          },
          "userId" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [
          "userId"
        ],
        "type" : "object"
      },
      "AyunoPeriodoDTO" : {
        "properties" : {
          "budgetStartDay" : {
            "format" : "int32",
            "maximum" : 31,
            "minimum" : 1,
            "type" : "integer"
          },
          "referenceDate" : {
            "format" : "date",
            "type" : "string"
          },
          "userId" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [
          "userId"
        ],
        "type" : "object"
      },
      "AyunoPlanDTO" : {
        "properties" : {
          "eatingHours" : {
            "format" : "int32",
            "type" : "integer"
          },
          "fastingHours" : {
            "format" : "int32",
            "type" : "integer"
          },
          "planType" : {
            "enum" : [
              "PLAN_12_12",
              "PLAN_14_10",
              "PLAN_16_8",
              "PLAN_18_6",
              "PLAN_20_4",
              "CUSTOM"
            ],
            "type" : "string"
          },
          "remindersEnabled" : {
            "type" : "boolean"
          },
          "suggestedStartTime" : {
            "maxLength" : 5,
            "minLength" : 0,
            "type" : "string"
          },
          "userId" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [
          "planType",
          "userId"
        ],
        "type" : "object"
      },
      "AyunoUsuarioDTO" : {
        "properties" : {
          "userId" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [
          "userId"
        ],
        "type" : "object"
      },
      "ResultDTO" : {
        "properties" : {
          "correct" : {
            "type" : "boolean"
          },
          "errorCode" : {
            "format" : "int32",
            "type" : "integer"
          },
          "message" : {
            "type" : "string"
          },
          "object" : {
            "type" : "object"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "El token que devuelve /v1/auth/login de auth-service",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
