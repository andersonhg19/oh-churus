# Detiene la búsqueda de lombok.config en directorios padre.
config.stopBubbling = true

# Anota el código generado por Lombok con @lombok.Generated.
# JaCoCo (0.8.2+) y SonarQube excluyen automáticamente los métodos
# marcados con esta anotación, de modo que getters/setters/builders
# generados no distorsionan la métrica de cobertura.
lombok.addLombokGeneratedAnnotation = true
