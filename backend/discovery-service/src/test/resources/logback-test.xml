<?xml version="1.0" encoding="UTF-8"?>
<!-- Solo para tests: baja el ruido de logs para una salida limpia. No afecta produccion. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="com.ohchurus" level="OFF"/>
</configuration>
